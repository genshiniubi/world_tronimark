# ---- 服务 ----
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
SESSION_SECRET=please-change-this-to-a-long-random-string
DATA_DIR=./data

# ---- C++ 工具链 ----
# 留空时自动探测 g++。当前项目开发环境使用：
# tools/msys64/mingw64/bin/g++.exe（GCC 16.2）
CXX=
CXX_STANDARD=c++17
CXX_FLAGS=-O2 -pipe -static-libgcc -static-libstdc++

# ---- Python ----
PYTHON=
PYTHON_FLAGS=-B

# ---- 调试（可选）----
# C++ 单步轨迹依赖 gdb；当前项目开发环境使用：
# tools/msys64/mingw64/bin/gdb.exe（GDB 18.1）
GDB=

# ---- 判题限制 ----
COMPILE_TIMEOUT_MS=15000
RUN_TIMEOUT_MS=3000
MAX_OUTPUT_BYTES=65536
MAX_SOURCE_BYTES=65536

# ---- AI（OpenAI 兼容接口）----
# 未配置 AI_API_KEY 时，站点自动使用本地补全 / 本地解释 / 规则复盘。
AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=20000
# 本地 Ollama 示例：
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=qwen2.5-coder:7b

# ---- 站点 ----
SITE_URL=http://127.0.0.1:5173
